# ========================================
# 台股國運基金 LINE Bot - 環境變數設定
# ========================================
# 將此檔案複製為 .env 並填入實際數值

# LINE Messaging API 憑證
# 請到 LINE Developers Console (https://developers.line.biz/console/) 取得
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# 推播目標（至少填一個）
# 群組 ID：將 Bot 加入群組後可取得
LINE_GROUP_ID=
# 或用戶 ID：
LINE_USER_ID=

# 監控間隔（秒），預設 300 秒（5 分鐘）
MONITOR_INTERVAL=300

# Google Sheets CSV 網址（通常不需要修改，已內建預設值）
# CSV_CORE=...
# CSV_MS=...
# CSV_WN=...
